{
  "mode": "manual",
  "allow": [
    "read_file",
    "get_file_info",
    "ls",
    "grep",
    "glob",
    "lsp",
    "git_status",
    "git_log",
    "git_diff",
    "todo_read",
    "todo_write",
    "list_skills",
    "load_skill",
    "clarify",
    "powershell:git *",
    "powershell:ls",
    "powershell:dir",
    "powershell:python --version",
    "powershell:node --version",
    "powershell:npm --version"
  ],
  "deny": [],
  "ask": [
    "powershell:rm *",
    "powershell:del *",
    "powershell:rmdir *",
    "powershell:rd *",
    "powershell:Remove-Item *",
    "powershell:Stop-Process *",
    "powershell:Stop-Service *",
    "powershell:taskkill *",
    "powershell:kill *",
    "powershell:shutdown *",
    "powershell:Stop-Computer *",
    "powershell:Restart-Computer *",
    "powershell:format *",
    "powershell:Format-Volume *",
    "powershell:Clear-Disk *",
    "powershell:diskpart *",
    "write_file:.env",
    "write_file:*.pem",
    "write_file:*.key",
    "write_file:.git/*",
    "write_file:*.secret",
    "write_file:credentials*",
    "delete_file"
  ]
}
