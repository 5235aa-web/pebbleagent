# ============================================================
# PebbleAgent - .gitignore
# Excludes: build artifacts, caches, runtime data, personal config
# ============================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------- Build artifacts ----------
/build/
/dist/
*.tsbuildinfo

# ---------- Dependencies ----------
node_modules/

# ---------- Frontend build output / caches ----------
frontend/dist/
frontend/dist-ssr/
frontend/coverage/
frontend/.vite/
frontend/.cache/
frontend/.eslintcache
frontend/.stylelintcache

# ---------- Frontend local logs / scratch ----------
frontend/.tsc.log
frontend/build*.log
frontend/.verify-scroll/

# ---------- Frontend local env ----------
frontend/.env.local
frontend/.env.*.local

# ---------- Tauri / Rust ----------
frontend/src-tauri/target/
frontend/src-tauri/.fingerprint/
frontend/src-tauri/.cargo/
frontend/src-tauri/gen/
frontend/src-tauri/binaries/

# Updater signing keys: the private half signs installers and must never be
# committed (the repository is public). Only the public key in tauri.conf.json
# belongs in git.
frontend/.tauri-keys/

# ---------- Design prototypes (never shipped) ----------
# design-preview/: local HTML mockups; referenced only by comments and
# prototype demo data, never loaded at runtime.
/design-preview/
# Root-level prototype pages only. The leading slash anchors these to the
# repository root, so frontend/index.html (the Vite entry) stays tracked.
# Add an exception such as "!/docs.html" if a root page ever must be shipped.
/*.html
/*.htm

# ---------- Runtime data (personal) ----------
/.pebble/
/history/
/agent_chat.db
gateway/permission_audit.db
gateway/err.txt
/.claude/
/brag-output/
/brag-output-*/

# ---------- Code-animation style pack (local assets) ----------
# 341 styles + 193 stills + offline picker, roughly 15 MB of third-party
# material under a custom non-commercial license. Kept out of the repo.
/skills/code-animation-styles/

# ---------- Personal config / backups / logs ----------
*.bak
*.log

# ---------- OS junk ----------
Thumbs.db
Desktop.ini
.DS_Store
