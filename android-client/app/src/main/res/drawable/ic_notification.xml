<?xml version="1.0" encoding="utf-8"?>
<!--
  Notification small icon.

  Deliberately an app-owned resource: the platform drawables previously used here
  (android.R.drawable.stat_*) are not guaranteed to exist on every OEM build, and
  a missing one makes startForeground throw, which kills the service silently.
  Status-bar icons are drawn as a white silhouette, so this is a flat glyph.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillType="evenOdd"
        android:pathData="M7,20 L7,4 L13,4 A4.6,4.6 0 0 1 13,13.2 L9.6,13.2 L9.6,20 Z M13,6.6 A2,2 0 1 0 13,10.6 A2,2 0 1 0 13,6.6 Z"
        android:fillColor="#FFFFFFFF" />
</vector>
